#!/bin/bash
# fzgit - Git operations with fzf
# Usage: fzgit [subcommand]
# Dependencies: git, fzf

set -e

# Check dependencies
command -v git >/dev/null 2>&1 || { echo "Error: git not installed"; exit 1; }
command -v fzf >/dev/null 2>&1 || { echo "Error: fzf not installed"; exit 1; }

# Check if in git repo
check_git_repo() {
    if ! git rev-parse --git-dir > /dev/null 2>&1; then
        echo "Error: Not in a git repository"
        exit 1
    fi
}

# Common fzf options
FZF_OPTS="
  --height 80%
  --layout reverse
  --border rounded
  --ansi
"

# Git log browser
git_log() {
    check_git_repo

    local selection
    selection=$(git log --color=always --format='%C(yellow)%h%Creset %C(green)%ar%Creset %C(blue)%an%Creset %s' "$@" | \
        fzf ${FZF_OPTS} \
        --prompt '󰊢 Log> ' \
        --preview 'git show --color=always {1} 2>/dev/null | head -200' \
        --preview-window right:50% \
        --bind 'enter:execute(git show {1} | less -R)' \
        --bind 'ctrl-d:execute(git diff {1}^..{1} | less -R)' \
        --bind 'ctrl-o:execute(git checkout {1})' \
        --bind 'ctrl-c:execute(git cherry-pick {1})' \
        --bind 'ctrl-r:execute(git revert {1})' \
        --bind 'ctrl-y:execute-silent(echo {1} | wl-copy)+abort' \
        --header 'Enter: show | Ctrl-D: diff | Ctrl-O: checkout | Ctrl-C: cherry-pick | Ctrl-R: revert | Ctrl-Y: copy hash')

    echo "$selection" | awk '{print $1}'
}

# Git branch browser
git_branch() {
    check_git_repo

    local branches selection
    branches=$(git branch -a --color=always | grep -v '/HEAD\s' | sort)

    selection=$(echo "$branches" | \
        fzf ${FZF_OPTS} \
        --prompt '󰘬 Branch> ' \
        --preview 'git log --oneline --graph --date=short --color=always --pretty="format:%C(auto)%cd %h%d %s" $(echo {} | sed "s/^[* ]*//" | sed "s/^remotes\\///") | head -30' \
        --preview-window right:50% \
        --bind 'enter:execute(git checkout $(echo {} | sed "s/^[* ]*//" | sed "s/^remotes\\/\\///"))' \
        --bind 'ctrl-d:execute(git branch -d $(echo {} | sed "s/^[* ]*//" | sed "s/^remotes\\/\\///"))' \
        --bind 'ctrl-D:execute(git branch -D $(echo {} | sed "s/^[* ]*//" | sed "s/^remotes\\/\\///"))' \
        --bind 'ctrl-m:execute(git merge $(echo {} | sed "s/^[* ]*//" | sed "s/^remotes\\/\\///"))' \
        --bind 'ctrl-r:execute(git rebase $(echo {} | sed "s/^[* ]*//" | sed "s/^remotes\\/\\///"))' \
        --bind 'ctrl-y:execute-silent(echo {} | sed "s/^[* ]*//" | sed "s/^remotes\\/\\///" | wl-copy)+abort' \
        --header 'Enter: checkout | Ctrl-D: delete | Ctrl-D: force delete | Ctrl-M: merge | Ctrl-R: rebase | Ctrl-Y: copy name')

    echo "$selection" | sed 's/^[* ]*//' | sed 's/^remotes\///'
}

# Git stash browser
git_stash() {
    check_git_repo

    local selection
    selection=$(git stash list --color=always --format='%C(yellow)%gd%Creset %C(green)%ar%Creset %s' | \
        fzf ${FZF_OPTS} \
        --prompt '󰋻 Stash> ' \
        --preview 'git stash show -p --color=always {1} 2>/dev/null | head -200' \
        --preview-window right:50% \
        --bind 'enter:execute(git stash pop {1})' \
        --bind 'ctrl-a:execute(git stash apply {1})' \
        --bind 'ctrl-d:execute(git stash drop {1})' \
        --bind 'ctrl-s:execute(git stash show -p {1} | less -R)' \
        --bind 'ctrl-y:execute-silent(echo {1} | wl-copy)+abort' \
        --header 'Enter: pop | Ctrl-A: apply | Ctrl-D: drop | Ctrl-S: show | Ctrl-Y: copy stash id')

    echo "$selection" | awk '{print $1}'
}

# Git status / add / diff
git_status() {
    check_git_repo

    local selection
    selection=$(git -c color.status=always status --short | \
        fzf ${FZF_OPTS} -m \
        --prompt '󰊢 Status> ' \
        --preview 'git diff --color=always {2} 2>/dev/null | head -200 || echo "New file: {2}" && cat {2} 2>/dev/null | head -50' \
        --preview-window right:50% \
        --bind 'enter:execute(git add {2})' \
        --bind 'ctrl-r:execute(git reset {2})' \
        --bind 'ctrl-d:execute(git diff --color=always {2} | less -R)' \
        --bind 'ctrl-o:execute(${EDITOR:-nvim} {2})' \
        --bind 'ctrl-c:execute(git checkout -- {2})' \
        --bind 'ctrl-a:select-all' \
        --header 'Enter: add | Ctrl-R: unstage | Ctrl-D: diff | Ctrl-O: edit | Ctrl-C: checkout | Ctrl-A: select all' | \
        awk '{print $2}')

    echo "$selection"
}

# Interactive commit builder
git_commit() {
    check_git_repo

    # First select files to stage
    echo "Select files to stage (multi-select with Tab):"
    local files
    files=$(git -c color.status=always status --short | \
        fzf ${FZF_OPTS} -m \
        --prompt '󰊢 Stage> ' \
        --preview 'git diff --color=always {2} 2>/dev/null | head -200 || cat {2} 2>/dev/null | head -50' \
        --preview-window right:50% \
        --bind 'ctrl-a:select-all' \
        --header 'Tab: multi-select | Ctrl-A: select all | Enter: stage selected' | \
        awk '{print $2}')

    if [[ -z "$files" ]]; then
        echo "No files selected"
        return
    fi

    # Stage selected files
    echo "$files" | while read -r file; do
        git add "$file"
        echo "Staged: $file"
    done

    # Get commit message
    echo ""
    echo "Enter commit message (Ctrl-C to cancel):"
    local msg
    msg=$(echo "" | fzf --print-query --prompt '󰊢 Commit message> ' --header 'Type message and press Enter to commit')

    if [[ -z "$msg" ]]; then
        echo "No commit message provided, files remain staged"
        return
    fi

    # Commit
    git commit -m "$msg"
}

# Worktree browser
git_worktree() {
    check_git_repo

    local selection
    selection=$(git worktree list --porcelain | \
        awk '/^worktree/{wt=$2} /^branch/{print wt, $2} /^HEAD/{print wt, "(detached)", $2}' | \
        fzf ${FZF_OPTS} \
        --prompt '󰙵 Worktree> ' \
        --preview 'ls -la {1} 2>/dev/null' \
        --preview-window right:40% \
        --bind 'enter:execute(cd {1})' \
        --bind 'ctrl-r:execute(git worktree remove {1})' \
        --bind 'ctrl-a:execute(git worktree add ../$(basename {1})_wt -b $(basename {1})_wt)' \
        --header 'Enter: cd | Ctrl-R: remove | Ctrl-A: add new worktree')

    echo "$selection" | awk '{print $1}'
}

# Remote branches
git_remote() {
    check_git_repo

    git fetch --all --prune 2>/dev/null || true

    local selection
    selection=$(git branch -r --color=always | \
        fzf ${FZF_OPTS} \
        --prompt '󰑃 Remote> ' \
        --preview 'git log --oneline --graph --color=always {} | head -30' \
        --preview-window right:50% \
        --bind 'enter:execute(git checkout -t {})' \
        --bind 'ctrl-d:execute(git push origin --delete $(echo {} | sed "s/^origin\///"))' \
        --header 'Enter: checkout -t | Ctrl-D: delete remote branch')

    echo "$selection"
}

# Help message
show_help() {
    cat << 'EOF'
Usage: fzgit [command]

Commands:
  log      - Browse git log with previews
  branch   - Switch, merge, rebase, delete branches
  stash    - Manage stashes (pop, apply, drop)
  status   - Interactive staging/unstaging
  commit   - Build a commit interactively
  worktree - Manage worktrees
  remote   - Checkout remote branches

Default (no command): status

Dependencies: git, fzf

Keybindings (vary by command):
  Enter      - Primary action
  Ctrl-O     - Open/checkout
  Ctrl-D     - Diff/delete
  Ctrl-Y     - Copy to clipboard
  Ctrl-A     - Select all (multi-select mode)
  Tab        - Multi-select
EOF
}

# Main
case "${1:-status}" in
    log)
        git_log "${@:2}"
        ;;
    branch)
        git_branch
        ;;
    stash)
        git_stash
        ;;
    status)
        git_status
        ;;
    commit)
        git_commit
        ;;
    worktree)
        git_worktree
        ;;
    remote)
        git_remote
        ;;
    -h|--help|help)
        show_help
        ;;
    *)
        echo "Unknown command: $1"
        show_help
        exit 1
        ;;
esac
