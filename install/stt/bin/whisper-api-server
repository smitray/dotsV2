#!/usr/bin/env python3
"""
Whisper STT API Server

OpenAI-compatible REST API for local speech-to-text using Whisper model.
Designed for continuous operation with manual GPU memory management.

Features:
    - OpenAI API compatible endpoint (/v1/audio/transcriptions)
    - GPU acceleration with CUDA (auto-fallback to CPU)
    - Health and readiness check endpoints
    - Manual VRAM management (no auto-shutdown)

Usage:
    whisper-api-server [options]

Options:
    --port, -p        API server port (default: 7861)
    --model, -m       Whisper model size (default: small)
    --device, -d      Device: auto, cuda, cpu (default: auto)
    --compute-type, -c  Compute type: auto, float16, int8 (default: auto)
    --host            Host to bind to (default: 0.0.0.0)

Environment Variables:
    WHISPER_PORT        Server port
    WHISPER_MODEL       Model size (tiny/base/small/medium/large-v3)
    WHISPER_DEVICE      Device preference (auto/cuda/cpu)
    WHISPER_COMPUTE_TYPE  Compute type (auto/float16/int8)

Example:
    whisper-api-server --model small --device cuda
"""

import os
import sys
import time
import tempfile
import signal
import argparse
from typing import Optional

from fastapi import FastAPI, File, UploadFile, Form
from fastapi.responses import PlainTextResponse, JSONResponse
from faster_whisper import WhisperModel


# =============================================================================
# Configuration Constants
# =============================================================================

DEFAULT_PORT = 7861
DEFAULT_MODEL = "small"
DEFAULT_DEVICE = "auto"
DEFAULT_COMPUTE_TYPE = "auto"
DEFAULT_HOST = "0.0.0.0"


# =============================================================================
# Argument Parsing
# =============================================================================

def parse_args() -> argparse.Namespace:
    """Parse command line arguments with environment variable fallbacks."""
    parser = argparse.ArgumentParser(
        description="Whisper STT API Server",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__
    )
    
    parser.add_argument(
        "--port", "-p",
        type=int,
        default=int(os.environ.get("WHISPER_PORT", DEFAULT_PORT)),
        help=f"API server port (default: {DEFAULT_PORT})"
    )
    parser.add_argument(
        "--model", "-m",
        type=str,
        default=os.environ.get("WHISPER_MODEL", DEFAULT_MODEL),
        help=f"Whisper model size (default: {DEFAULT_MODEL})"
    )
    parser.add_argument(
        "--device", "-d",
        type=str,
        default=os.environ.get("WHISPER_DEVICE", DEFAULT_DEVICE),
        help=f"Device: auto, cuda, cpu (default: {DEFAULT_DEVICE})"
    )
    parser.add_argument(
        "--compute-type", "-c",
        type=str,
        dest="compute_type",
        default=os.environ.get("WHISPER_COMPUTE_TYPE", DEFAULT_COMPUTE_TYPE),
        help=f"Compute type: auto, float16, int8 (default: {DEFAULT_COMPUTE_TYPE})"
    )
    parser.add_argument(
        "--host",
        type=str,
        default=os.environ.get("WHISPER_HOST", DEFAULT_HOST),
        help=f"Host to bind to (default: {DEFAULT_HOST})"
    )
    
    return parser.parse_args()


# =============================================================================
# Device Detection
# =============================================================================

def detect_device(preferred: str) -> tuple[str, str]:
    """
    Detect best available device for inference.
    
    Args:
        preferred: User's preferred device (auto, cuda, cpu)
    
    Returns:
        Tuple of (device, compute_type)
    """
    if preferred != "auto":
        device = preferred
        compute_type = "float16" if device == "cuda" else "int8"
        return device, compute_type
    
    # Auto-detect: prefer CUDA if NVIDIA GPU available
    if os.path.exists("/proc/driver/nvidia"):
        try:
            import subprocess
            result = subprocess.run(
                ["nvidia-smi", "--query-gpu=memory.free", "--format=csv,noheader,nounits"],
                capture_output=True, text=True, timeout=5
            )
            free_mem = int(result.stdout.strip().split('\n')[0])
            if free_mem > 600:
                print(f"[{time.strftime('%H:%M:%S')}] NVIDIA GPU detected, {free_mem}MB VRAM free")
                return "cuda", "float16"
        except Exception as e:
            print(f"[{time.strftime('%H:%M:%S')}] GPU check failed: {e}")
    
    print(f"[{time.strftime('%H:%M:%S')}] No GPU available, using CPU")
    return "cpu", "int8"


# =============================================================================
# Model Management
# =============================================================================

class WhisperModelManager:
    """
    Manages Whisper model lifecycle and transcription.
    
    Handles model loading, caching, and audio transcription with proper
    error handling and device fallback.
    """
    
    def __init__(self, model_size: str, device: str, compute_type: str):
        self.model_size = model_size
        self.device = device
        self.compute_type = compute_type
        self.model = None
    
    def load(self) -> WhisperModel:
        """
        Load the Whisper model with CUDA fallback.
        
        Returns:
            Loaded WhisperModel instance
        """
        if self.model is None:
            print(f"[{time.strftime('%H:%M:%S')}] Loading model '{self.model_size}' on {self.device} ({self.compute_type})...")
            start = time.time()
            
            try:
                self.model = WhisperModel(
                    self.model_size,
                    device=self.device,
                    compute_type=self.compute_type
                )
                elapsed = time.time() - start
                print(f"[{time.strftime('%H:%M:%S')}] Model loaded in {elapsed:.1f}s")
                
            except RuntimeError as e:
                if "cuda" in self.device.lower() and ("libcublas" in str(e) or "CUDA" in str(e)):
                    print(f"[{time.strftime('%H:%M:%S')}] CUDA failed: {e}")
                    print(f"[{time.strftime('%H:%M:%S')}] Falling back to CPU...")
                    self.device = "cpu"
                    self.compute_type = "int8"
                    self.model = WhisperModel(
                        self.model_size,
                        device=self.device,
                        compute_type=self.compute_type
                    )
                else:
                    raise
        
        return self.model
    
    def transcribe(self, audio_path: str, language: Optional[str] = None) -> str:
        """
        Transcribe audio file to text.
        
        Args:
            audio_path: Path to audio file
            language: Language code (None for auto-detect)
        
        Returns:
            Transcribed text
        """
        model = self.load()
        
        segments, info = model.transcribe(
            audio_path,
            language=language or "en",
            condition_on_previous_text=False,
            vad_filter=False  # Disabled: was filtering out short speech segments
        )
        
        text = " ".join([segment.text for segment in segments]).strip()
        return text


# =============================================================================
# FastAPI Application
# =============================================================================

def create_app(model_manager: WhisperModelManager) -> FastAPI:
    """
    Create and configure FastAPI application.
    
    Args:
        model_manager: WhisperModelManager instance
    
    Returns:
        Configured FastAPI application
    """
    app = FastAPI(
        title="Whisper STT API",
        description="OpenAI-compatible Speech-to-Text API using local Whisper model",
        version="1.0.0",
        docs_url="/docs",
        redoc_url="/redoc"
    )
    
    @app.get("/")
    async def root():
        """Root endpoint with API info."""
        return {
            "name": "Whisper STT API",
            "version": "1.0.0",
            "docs": "/docs",
            "openapi": "/openapi.json"
        }
    
    @app.get("/health")
    async def health():
        """
        Health check endpoint.
        
        Returns server status and configuration.
        """
        return {
            "status": "ok",
            "model": model_manager.model_size,
            "device": model_manager.device,
            "compute_type": model_manager.compute_type
        }
    
    @app.get("/ready")
    async def ready():
        """
        Readiness check endpoint.
        
        Returns 200 when model is loaded, 503 otherwise.
        """
        if model_manager.model is not None:
            return {"status": "ready"}
        return JSONResponse(status_code=503, content={"status": "loading"})
    
    @app.post("/v1/audio/transcriptions")
    async def transcribe(
        file: UploadFile = File(..., description="Audio file (WAV, MP3, FLAC, etc.)"),
        model: str = Form(default="small", description="Model name (for compatibility)"),
        language: Optional[str] = Form(default=None, description="Language code (e.g., 'en', 'es')"),
        response_format: str = Form(default="json", description="Response format: 'json' or 'text'")
    ):
        """
        Transcribe audio file to text.
        
        OpenAI API compatible endpoint. Accepts various audio formats and
        returns transcription in JSON or plain text format.
        
        Args:
            file: Uploaded audio file
            model: Model name (ignored, uses server's configured model)
            language: Language code for transcription
            response_format: Response format (json/text)
        
        Returns:
            Transcription result in requested format
        """
        # Save uploaded file temporarily
        with tempfile.NamedTemporaryFile(delete=False, suffix=".wav") as tmp:
            content = await file.read()
            tmp.write(content)
            tmp_path = tmp.name
        
        try:
            # Transcribe
            text = model_manager.transcribe(tmp_path, language)
            
            # Return in requested format
            if response_format == "json":
                return {"text": text}
            else:
                return PlainTextResponse(content=text)
        
        except Exception as e:
            print(f"[{time.strftime('%H:%M:%S')}] Transcription error: {e}")
            return JSONResponse(status_code=500, content={"error": str(e)})
        
        finally:
            # Cleanup temp file
            try:
                os.unlink(tmp_path)
            except Exception:
                pass
    
    @app.get("/v1/models")
    async def list_models():
        """
        List available models (OpenAI compatibility).
        
        Returns:
            List of available models
        """
        return {
            "object": "list",
            "data": [
                {
                    "id": model_manager.model_size,
                    "object": "model",
                    "created": int(time.time()),
                    "owned_by": "openai"
                }
            ]
        }
    
    return app


# =============================================================================
# Signal Handling & PID Management
# =============================================================================

def create_pid_file(pid_path: str) -> None:
    """Create PID file for process management."""
    try:
        with open(pid_path, 'w') as f:
            f.write(str(os.getpid()))
    except Exception as e:
        print(f"Warning: Could not write PID file: {e}")


def remove_pid_file(pid_path: str) -> None:
    """Remove PID file on shutdown."""
    try:
        os.unlink(pid_path)
    except Exception:
        pass


# =============================================================================
# Main Entry Point
# =============================================================================

def main():
    """Main entry point."""
    args = parse_args()
    
    # Detect device
    device, compute_type = detect_device(args.device)
    
    # Override compute type if explicitly set
    if args.compute_type != "auto":
        compute_type = args.compute_type
    
    # Print startup banner
    print("=" * 50)
    print("Whisper STT API Server")
    print("=" * 50)
    print(f"Host: {args.host}")
    print(f"Port: {args.port}")
    print(f"Model: {args.model}")
    print(f"Device: {device}")
    print(f"Compute: {compute_type}")
    print("=" * 50)
    
    # Create model manager and app
    model_manager = WhisperModelManager(args.model, device, compute_type)
    app = create_app(model_manager)
    
    # Create PID file
    pid_path = f"/run/user/{os.getuid()}/whisper-api-server.pid"
    try:
        os.makedirs(os.path.dirname(pid_path), exist_ok=True)
        create_pid_file(pid_path)
    except Exception:
        pid_path = f"/tmp/whisper-api-server.pid"
        create_pid_file(pid_path)
    
    # Import uvicorn here to avoid early imports
    import uvicorn
    
    try:
        uvicorn.run(
            app,
            host=args.host,
            port=args.port,
            log_level="warning"
        )
    finally:
        print(f"\n[{time.strftime('%H:%M:%S')}] Server shutting down...")
        remove_pid_file(pid_path)


if __name__ == "__main__":
    main()
