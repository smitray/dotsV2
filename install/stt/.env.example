# Whisper STT Environment Configuration
#
# This file is copied to ~/.config/hypr-stt/env during installation.
# Edit ~/.config/hypr-stt/env after installation to customize settings.
#

# =============================================================================
# SERVER CONFIGURATION
# =============================================================================

# API server port
# Default: 7861
# Note: This port is used by OpenWebUI and other compatible clients
export WHISPER_PORT=7861

# Whisper model size
# Options: tiny, base, small, medium, large-v3
# 
# Model comparison:
#   tiny      - 39MB   - Fastest, least accurate - VRAM: ~300MB
#   base      - 74MB   - Fast, decent accuracy   - VRAM: ~400MB
#   small     - 244MB  - Balanced (default)      - VRAM: ~600MB
#   medium    - 769MB  - Slower, better accuracy - VRAM: ~1.5GB
#   large-v3  - 3GB    - Slowest, best accuracy  - VRAM: ~3GB
export WHISPER_MODEL=small

# Device selection: auto, cuda, cpu
# - auto: Auto-detect (prefers CUDA if GPU available with >600MB VRAM)
# - cuda: Force GPU acceleration
# - cpu:  Force CPU (slower but frees GPU for other tasks)
#
# Tip: Use 'cpu' if you want to maximize VRAM for other ML workloads
# export WHISPER_DEVICE=auto

# Compute type: auto, float16, int8, int8_float16
# - auto: Auto-select based on device
# - float16: Best for CUDA (GPU)
# - int8: Best for CPU
# export WHISPER_COMPUTE_TYPE=auto

# Server host binding
# - 127.0.0.1: Localhost only (more secure, default)
# - 0.0.0.0:   All interfaces (allows OpenWebUI on other machines)
# export WHISPER_HOST=0.0.0.0

# =============================================================================
# CLIENT CONFIGURATION (hypr-stt)
# =============================================================================

# Full API endpoint URL
# Used by hypr-stt script for transcription requests
export HYPR_STT_API_URL=http://localhost:${WHISPER_PORT}/v1/audio/transcriptions

# Model name sent to API (should match WHISPER_MODEL)
export HYPR_STT_MODEL=${WHISPER_MODEL}

# API port for health checks
export HYPR_STT_PORT=${WHISPER_PORT}

# Language code for transcription
# Common codes: en, es, fr, de, hi, zh, ja, ko, ru, pt, it
# Full list: https://github.com/openai/whisper/blob/main/whisper/tokenizer.py
export HYPR_STT_LANGUAGE=en

# Path to whisper-api-server script (auto-detected if not set)
# export HYPR_STT_SERVER=$HOME/.local/bin/whisper-api-server

# Keybinding hint (for status display)
# export HYPR_STT_KEYBIND=SUPER+N

# =============================================================================
# OPENWEBUI INTEGRATION
# =============================================================================
#
# To use this STT server with OpenWebUI:
#
# 1. Start the Whisper server:
#    ~/.local/bin/hypr-stt start-server
#
# 2. In OpenWebUI settings, configure Speech-to-Text:
#    - Endpoint: http://localhost:7861/v1/audio/transcriptions
#    - API Key: (leave empty - local server doesn't require auth)
#    - Model: small (or whatever WHISPER_MODEL you set)
#
# 3. For OpenWebUI on a different machine:
#    - Set WHISPER_HOST=0.0.0.0 above
#    - Use your machine's IP: http://192.168.x.x:7861/v1/audio/transcriptions
#    - Ensure port 7861 is allowed in firewall
#
# 4. Free VRAM before running LLM in OpenWebUI:
#    ~/.local/bin/hypr-stt stop-server
#
# =============================================================================

# =============================================================================
# MODEL CACHE CONFIGURATION (Hugging Face)
# =============================================================================

# Location for Hugging Face model cache
# Default: ~/.cache/huggingface/
# Change if you have limited home partition space
# export HF_HOME=$HOME/.cache/huggingface
# export HF_HOME=/mnt/storage/huggingface

# Alternative cache location (some tools use this)
# export TRANSFORMERS_CACHE=$HOME/.cache/huggingface

# =============================================================================
# HYPRland KEYBINDING EXAMPLES
# =============================================================================
#
# Add to ~/.config/hypr/hyprland.conf:
#
# # Primary: Super+N to toggle recording
# bind = SUPER, N, exec, ~/.local/bin/hypr-stt toggle
#
# # Server Management (GPU control)
# bind = SUPER SHIFT, S, exec, ~/.local/bin/hypr-stt start-server
# bind = SUPER SHIFT, R, exec, ~/.local/bin/hypr-stt restart-server
# bind = SUPER ALT, R, exec, ~/.local/bin/hypr-stt stop-server
# bind = SUPER CTRL, R, exec, ~/.local/bin/hypr-stt reset
#
# =============================================================================

# =============================================================================
# WAYBAR INTEGRATION (Optional)
# =============================================================================
#
# Add to ~/.config/waybar/config (in modules array):
#
#   "custom/stt": {
#     "format": "{}",
#     "return-type": "json",
#     "interval": 1,
#     "exec": "~/.local/bin/hypr-stt status",
#     "signal": 8,
#     "on-click": "~/.local/bin/hypr-stt toggle"
#   }
#
# Add to ~/.config/waybar/style.css:
#
#   #custom-stt {
#     padding: 0 10px;
#     margin: 4px 2px;
#     border-radius: 4px;
#     font-weight: bold;
#   }
#   #custom-stt.recording {
#     background-color: #f38ba8;
#     color: #1e1e2e;
#     animation: stt-blink 1s infinite;
#   }
#   #custom-stt.processing {
#     background-color: #fab387;
#     color: #1e1e2e;
#   }
#   #custom-stt.idle {
#     background-color: transparent;
#     color: #cdd6f4;
#   }
#   @keyframes stt-blink {
#     0%, 100% { opacity: 1; }
#     50% { opacity: 0.5; }
#   }
