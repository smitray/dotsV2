# Whisper STT Environment Configuration
# This file defines all default environment variables for the STT system
#
# This .env file is copied to ~/.config/hypr-stt/env during installation
# You can edit THIS file before running install.sh to set your preferences,
# or edit ~/.config/hypr-stt/env after installation.
#

# ============================================================================
# SERVER CONFIGURATION (whisper-api-server)
#============================================================================

# API server port
export WHISPER_PORT=7861

# Whisper model size: tiny, base, small, medium, large-v3
# tiny:   39MB   - Fastest, least accurate
# base:   74MB   - Fast, decent accuracy
# small:  244MB  - Balanced speed/accuracy (default)
# medium: 769MB  - Slower, better accuracy
# large-v3: 3GB - Slowest, best accuracy
export WHISPER_MODEL=small

# Idle timeout in seconds before automatically shutting down server to free VRAM
# 300 = 5 minutes (default)
# 600 = 10 minutes
export WHISPER_IDLE_TIMEOUT=300

# Force device selection (cuda/cpu)
# If not set, auto-detects: cuda if GPU available with >600MB VRAM, else cpu
# export WHISPER_DEVICE=cuda
# export WHISPER_DEVICE=cpu

# ============================================================================
# CLIENT CONFIGURATION (hypr-stt)
# ============================================================================

# Full API endpoint URL
export HYPR_STT_API_URL=http://localhost:${WHISPER_PORT}/v1/audio/transcriptions

# Whisper model name sent to API (usually matches WHISPER_MODEL)
export HYPR_STT_MODEL=${WHISPER_MODEL}

# API port for health checks (usually matches WHISPER_PORT)
export HYPR_STT_PORT=${WHISPER_PORT}

# Language code for transcription
# Common: en, es, fr, de, hi, zh, ja, ko
# See Whisper languages for full list
export HYPR_STT_LANGUAGE=en

# Path to whisper-api-server script (auto-detected if not set)
# export HYPR_STT_SERVER=~/.local/bin/whisper-api-server

# ============================================================================
# MODEL CACHE CONFIGURATION (Hugging Face)
# ============================================================================

# Location for Hugging Face model cache
# Default: ~/.cache/huggingface/
# Change to a different location if you have limited home space
# export HF_HOME=$HOME/.cache/huggingface
# export HF_HOME=/mnt/storage/huggingface

# ============================================================================
# RUNTIME PATH CONFIGURATION
# ============================================================================

# Runtime directory for state files, PID files, and logs
# Default: /run/user/$UID (secure, per-user)
# Falls back to /tmp if /run/user/ unavailable
# export HYPR_STT_RUN_DIR=/run/user/$(id -u)
